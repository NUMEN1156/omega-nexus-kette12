# Copy to .env.stack on the deployment host and chmod 600.
# Never commit .env.stack or replace placeholders with real secrets.

OUTBOX_TOPIC_FILTERS=clap.embedding.request

# Fail-closed default: settlement is disabled.
L1_EVM_ENABLED=false
L1_EVM_RPC_URL=http://anvil:8545
L1_EVM_CHAIN_ID=31337
# Required only when L1_EVM_ENABLED=true.
L1_EVM_FROM=
L1_EVM_TO=

COMPOSE_PROJECT_NAME=omega-nexus
